# Copy to .env (docker/seed.sh does this for you if it is missing).
#
# Ports follow the ecosystem allocation recorded in credentials.md — change
# them only if they clash with another stack on your machine, and if you do,
# update credentials.md so the next person is not surprised.
WP_PORT=8113
DB_PORT=3312
PMA_PORT=8114
MAILPIT_PORT=8040

# Local-only development credentials. This database is never exposed beyond
# the Docker network and the ports above.
MYSQL_DATABASE=wp
MYSQL_USER=wp
MYSQL_PASSWORD=wp
MYSQL_ROOT_PASSWORD=root

# WordPress admin password for this stack. Left EMPTY on purpose: this file is
# tracked in a public repository, and a credential-shaped value here is a
# finding for the secret gate regardless of what it protects. docker/seed.sh
# generates one on the first run, appends it to your own .env (gitignored) and
# prints it in its closing summary.
WP_ADMIN_PASS=
