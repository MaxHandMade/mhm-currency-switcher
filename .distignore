# ============================================================================
# .distignore — WordPress.org SVN standart format
# Consumer: bin/build-release.py
# ============================================================================

# Version control & CI
.git
.github
.gitignore
.gitattributes

# Internal task/planning artifacts (SDD briefs, reports, review diffs)
.superpowers/

# Local development stack (docker-compose, php ini, seed script).
# Never ships: it is a developer convenience, and a WordPress.org package
# carrying a docker-compose.yml is both noise and a reviewer flag.
docker/

# IDE / Editor
.vscode
.idea
.cursor
# Claude Code's own project config (permissions, settings) -- editor
# tooling, not plugin code; untracked (neither committed nor in
# .gitignore), so build-release.py's filesystem walk would otherwise
# stage it straight into the ZIP.
.claude
# Pencere kartı (hafıza mimarisi v2) — geliştirme aracı, sevk paketinde işi yok.
# `.claude` tek başına bunu KAPSAMAZ: kart depo kökünde ayrı bir dosyadır.
# Window cards. Both are generated per-repo and carry internal infrastructure
# detail: the private dev repo path, the memory layout, the orchestrator name.
# They are the same class of file for two different tools, so they are excluded
# together; a third one (GEMINI.md and friends) belongs here too.
# 2026-09-07: the AGENTS.md line was missing here while the sibling plugin
# (mhm-rentiva) had both, and it shipped inside a 2.2.0 build until the pre-ZIP
# content audit caught it.
AGENTS.md
CLAUDE.md

# Build & Dependencies
vendor/
node_modules/
composer.json
composer.lock
package.json
package-lock.json
webpack.config.js
jest.config.js

# React admin app source (only admin-app/build/, the compiled bundle, ships)
admin-app/src/
# NOTE: The plugin root "build/" directory (where we stage release ZIPs) is
# pruned by build-release.py directly — NOT via this .distignore — because
# a plain "build/" pattern would also exclude admin-app/build/, which is the
# production React bundle that MUST ship with the plugin.

# Scripts & Tools (dev-only, not shipped)
bin/
tools/

# Tests
tests/
phpunit.xml
phpunit.xml.dist
phpunit-integration.xml.dist
.phpunit.result.cache

# Static analysis & linting
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
phpstan-bootstrap.php


# WordPress.org directory assets (banner/icon/screenshot).
# These belong in the SVN repo's /assets/ directory, NOT in the plugin ZIP —
# shipping them adds ~1.4 MB to every download for files WordPress never reads.
.wordpress-org/
# Documentation (internal — not shipped)
docs/
CHANGELOG.md
CONTRIBUTING.md
README-tr.md
# README.md is read on GitHub, where its relative links to .wordpress-org/
# resolve. That directory is excluded from the ZIP (WordPress.org takes those
# assets through SVN, not the plugin folder), so a README.md inside the ZIP
# would carry a hero image and six screenshots that are not there. Nothing
# renders it in a WordPress install either. readme.txt is the documentation
# that ships.
README.md
# readme.txt is the WordPress.org standard — KEEP

# Translation catalogues: the RUNTIME files ship, the editable source does not.
#
# Ships: languages/*.pot (template), *.mo and *.l10n.php (PHP strings) and
# *.json (the React admin panel's strings, keyed by md5 of the script path).
# Does not ship: languages/*.po — WordPress never reads it at runtime.
#
# 2026-09-17: these compiled files used to be excluded too, on the premise
# that WordPress.org's GlotPress would serve them as language packs. Measured
# after 2.2.0 shipped: translate.wordpress.org stable/tr was 0% (232/232
# untranslated) and the tr_TR language pack returned 404, so every WordPress.org
# install showed an English plugin on a Turkish site.
#
# How WordPress picks these up (measured against core source, not assumed):
# - PHP (.mo/.l10n.php): core registers the plugin's "Domain Path" header as a
#   lookup path only since WordPress 6.8 (wp-settings.php, set_custom_path();
#   absent from the 6.6 and 6.7 tags). WP_Textdomain_Registry searches
#   wp-content/languages/plugins/ FIRST, so a GlotPress language pack wins
#   whenever one exists. On WordPress 6.6-6.7 the bundled PHP catalogue is not
#   read and those strings stay English, exactly as before this change. This
#   plugin deliberately does not call load_plugin_textdomain() (Plugin Check
#   discourages it for directory-hosted plugins).
# - React admin (.json): Settings.php passes an explicit path to
#   wp_set_script_translations(), and load_script_textdomain() checks that path
#   BEFORE wp-content/languages/, so the bundled JSON is read on every supported
#   version and takes precedence over a language pack. Keep it current with
#   bin/make-i18n.sh whenever strings change.
# Locked by bin/test-distignore.py.
#
# Directory-bound on purpose: bin/build-release.py:66 runs fnmatch() against
# the FULL relative path, and fnmatch's "*" crosses "/" — a bare "*.po"-style
# pattern would reach files outside languages/.
languages/*.po

# Distribution config
.distignore

# Temp / build artifacts
*.log
*.zip
.tmp_scan.csv
build_debug.txt
