#. translators: 1: currency code, for example TRY. 2: the number of decimals that was stored instead, a whole number from 0 to 4.
#: admin-app/src/App.jsx:96
#, js-format
msgid "%1$s: the number of decimals must be a number, so %2$d was used."
msgstr "%1$s: Die Anzahl der Dezimalstellen muss eine Zahl sein, daher wurde %2$d verwendet."

#. translators: 1: currency code, for example TRY. 2: the number of decimals that was stored instead, a whole number from 0 to 4.
#: admin-app/src/App.jsx:106
#, js-format
msgid "%1$s: currencies use between 0 and 4 decimals, so the value was adjusted to %2$d."
msgstr "%1$s: Währungen verwenden 0 bis 4 Dezimalstellen, daher wurde der Wert auf %2$d angepasst."

#. translators: %s: currency code, for example TRY.
#: admin-app/src/App.jsx:116
#, js-format
msgid "%s: a decimal separator is required while decimals are shown, so the store setting was used."
msgstr "%s: Solange Dezimalstellen angezeigt werden, ist ein Dezimaltrennzeichen erforderlich, daher wurde die Shop-Einstellung verwendet."

#. translators: %s: currency code, for example TRY.
#: admin-app/src/App.jsx:125
#, js-format
msgid "%s: the thousands and decimal separators cannot be the same, so the thousands separator was removed."
msgstr "%s: Tausender- und Dezimaltrennzeichen dürfen nicht gleich sein, daher wurde das Tausendertrennzeichen entfernt."

#. translators: %s: currency code, for example TRY.
#: admin-app/src/App.jsx:134
#, js-format
