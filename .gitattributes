# Normalize all text files to LF in the repository, regardless of the
# committer's platform. Without this, Windows checkouts (core.autocrlf=true)
# can store CRLF blobs, which WordPress Coding Standards flags as an
# InvalidEOLChar error and fails CI on Linux runners.
* text=auto eol=lf

# Explicit source types (belt-and-suspenders).
*.php   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf
*.po    text eol=lf
*.pot   text eol=lf
*.sh    text eol=lf

# Binary assets — never touch line endings.
tests/fixtures/*.pem binary
*.pem   binary
*.mo    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
